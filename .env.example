# Copy to .env and adjust. docker compose reads .env from this directory.

# --- Web access -----------------------------------------------------------------
# Host port where the app (frontend + /api proxy) is published.
HTTP_PORT=8080
# Host interface to bind. Set to the server's Tailscale IP (100.x.y.z) to accept
# connections only from the tailnet.
HTTP_BIND=0.0.0.0

# --- Database (compose builds DATABASE_URL for the backend from these) -----------
POSTGRES_USER=research_repo
# Required. Use URL-safe characters (letters, digits, - _ .) since it is embedded
# in a connection URL.
POSTGRES_PASSWORD=change-me
POSTGRES_DB=research_repo

# --- Owner account -----------------------------------------------------------------
# On startup, if the database has no users and both values are set, this owner is
# created. Ignored afterwards; you may remove them from .env once the owner exists.
# Alternative: docker compose exec backend python -m research_repo.cli create-owner --email you@example.org
OWNER_EMAIL=
OWNER_PASSWORD=
OWNER_DISPLAY_NAME=

# --- Sessions and login ------------------------------------------------------------
# Login session lifetime in days.
SESSION_TTL_DAYS=30
# Set the Secure flag on the session cookie. Keep false when the app is served over
# plain HTTP (e.g. http://<tailscale-ip>:8080); set true behind HTTPS.
COOKIE_SECURE=false
# Failed logins allowed per email and per client IP within the window before
# further attempts get HTTP 429.
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# --- Uploads -----------------------------------------------------------------------
# Largest PDF accepted per upload, in megabytes. This one value drives both the backend
# and the frontend's nginx (client_max_body_size is rendered from it when the container
# starts), so there is nothing else to keep in step.
MAX_UPLOAD_MB=200

# --- Metadata suggestions ------------------------------------------------------------
# When a PDF is added, the backend looks for a DOI in it and asks Crossref
# (api.crossref.org) for the metadata. Set to false to make no outbound requests at all;
# then only the PDF's own embedded title/author/date is used.
METADATA_LOOKUP_ENABLED=true
# Total time budget, in seconds, for one suggestion (PDF inspection + Crossref). Uploads
# never fail because of a slow or failed lookup; they just get no suggestion.
METADATA_LOOKUP_TIMEOUT_SECONDS=6
# Optional contact e-mail sent to Crossref in the User-Agent, as their etiquette asks
# ("polite" pool). Leave empty to send none.
CROSSREF_MAILTO=

# --- Citation service ------------------------------------------------------------------
# APA 7 references are rendered by the internal "citeproc" service (citeproc-js with the
# official APA style). The backend reaches it at http://citeproc:8080 inside compose.
# Longest wait, in seconds, for one rendering request (a large bibliography takes seconds).
# If the service is down or slower than this, citation endpoints answer 503
# citation.unavailable; the rest of the app keeps working.
CITEPROC_TIMEOUT_SECONDS=30
# Largest request the citation service accepts, in megabytes (a request carries the CSL-JSON
# of every source in the project or export).
CITEPROC_MAX_BODY_MB=32

# --- Backend -----------------------------------------------------------------------
LOG_LEVEL=INFO

# --- Local development only (not used by docker compose) -----------------------------
# The backend reads these directly when run outside Docker.
# DATABASE_URL=postgresql+asyncpg://research_repo:change-me@localhost:5432/research_repo
# STORAGE_DIR=./data/storage
# Citation service started by hand: cd citeproc && npm ci && PORT=8081 node server.js
# CITEPROC_URL=http://localhost:8081
# Test database; the test suite wipes it.
# TEST_DATABASE_URL=postgresql+asyncpg://research_repo:change-me@localhost:5432/research_repo_test
# The citation tests start citeproc/server.js themselves (needs Node 22 and `npm ci` in
# citeproc/); set this instead to use a citation service that is already running.
# CITEPROC_TEST_URL=http://localhost:8081
