# Copy to .env and adjust. docker compose reads .env from this directory.

# --- Web access -----------------------------------------------------------------
# Host port where the app (frontend + /api proxy) is published.
HTTP_PORT=8080
# Host interface to bind. Set to the server's Tailscale IP (100.x.y.z) to accept
# connections only from the tailnet.
HTTP_BIND=0.0.0.0

# --- Database (compose builds DATABASE_URL for the backend from these) -----------
POSTGRES_USER=research_repo
# Required. Use URL-safe characters (letters, digits, - _ .) since it is embedded
# in a connection URL.
POSTGRES_PASSWORD=change-me
POSTGRES_DB=research_repo

# --- Owner account -----------------------------------------------------------------
# On startup, if the database has no users and both values are set, this owner is
# created. Ignored afterwards; you may remove them from .env once the owner exists.
# Alternative: docker compose exec backend python -m research_repo.cli create-owner --email you@example.org
OWNER_EMAIL=
OWNER_PASSWORD=
OWNER_DISPLAY_NAME=

# --- Sessions and login ------------------------------------------------------------
# Login session lifetime in days.
SESSION_TTL_DAYS=30
# Set the Secure flag on the session cookie. Keep false when the app is served over
# plain HTTP (e.g. http://<tailscale-ip>:8080); set true behind HTTPS.
COOKIE_SECURE=false
# Failed logins allowed per email and per client IP within the window before
# further attempts get HTTP 429.
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# --- Uploads -----------------------------------------------------------------------
# Largest PDF accepted per upload, in megabytes. The frontend's nginx also caps request
# bodies (client_max_body_size 200m in frontend/nginx.conf); raise both together.
MAX_UPLOAD_MB=200

# --- Backend -----------------------------------------------------------------------
LOG_LEVEL=INFO

# --- Local development only (not used by docker compose) -----------------------------
# The backend reads these directly when run outside Docker.
# DATABASE_URL=postgresql+asyncpg://research_repo:change-me@localhost:5432/research_repo
# STORAGE_DIR=./data/storage
# Test database; the test suite wipes it.
# TEST_DATABASE_URL=postgresql+asyncpg://research_repo:change-me@localhost:5432/research_repo_test
